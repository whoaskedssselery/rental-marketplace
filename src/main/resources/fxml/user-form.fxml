<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="rentalmarketplace.fx.controller.UserFormController"
      spacing="12" prefWidth="440">
    <padding>
        <Insets top="4" right="4" bottom="4" left="4"/>
    </padding>
    <GridPane hgap="12" vgap="10">
        <columnConstraints>
            <ColumnConstraints minWidth="90"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>
        <Label text="ФИО" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="nameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Email" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="emailField" promptText="name@example.com"
                   GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="Телефон" styleClass="form-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="phoneField" promptText="Необязательно"
                   GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Label text="Роль" styleClass="form-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <ComboBox fx:id="roleBox" maxWidth="Infinity" promptText="Выберите роль"
                  GridPane.rowIndex="3" GridPane.columnIndex="1"/>
    </GridPane>
</VBox>
