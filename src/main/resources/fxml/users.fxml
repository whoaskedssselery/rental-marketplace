<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="rentalmarketplace.fx.controller.UsersController"
      spacing="10">
    <padding>
        <Insets top="12" right="12" bottom="12" left="12"/>
    </padding>
    <HBox alignment="CENTER_LEFT" spacing="8">
        <Button fx:id="addButton" text="Добавить" onAction="#onAdd" styleClass="primary-button"/>
        <Button fx:id="editButton" text="Изменить" onAction="#onEdit"
                styleClass="secondary-button"/>
        <Button fx:id="deleteButton" text="Удалить" onAction="#onDelete"
                styleClass="danger-button"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="countLabel" styleClass="muted-text"/>
    </HBox>
    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idColumn" text="Номер" prefWidth="70"/>
            <TableColumn fx:id="nameColumn" text="ФИО" prefWidth="190"/>
            <TableColumn fx:id="emailColumn" text="Email" prefWidth="220"/>
            <TableColumn fx:id="phoneColumn" text="Телефон" prefWidth="140"/>
            <TableColumn fx:id="roleColumn" text="Роль" prefWidth="120"/>
            <TableColumn fx:id="createdColumn" text="Создан" prefWidth="130"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>
    <HBox spacing="12">
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label fx:id="listingsTitle" styleClass="page-title"/>
            <ListView fx:id="listingsList" prefHeight="120" minHeight="80"/>
        </VBox>
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label fx:id="requestsTitle" styleClass="page-title"/>
            <ListView fx:id="requestsList" prefHeight="120" minHeight="80"/>
        </VBox>
    </HBox>
</VBox>
