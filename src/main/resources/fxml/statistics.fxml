<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="rentalmarketplace.fx.controller.StatisticsController"
            fitToWidth="true">
    <VBox spacing="16">
        <padding>
            <Insets top="12" right="12" bottom="12" left="12"/>
        </padding>

        <FlowPane hgap="12" vgap="12">
            <VBox styleClass="panel" prefWidth="330" spacing="4">
                <Label text="Заявки" styleClass="page-title"/>
                <VBox fx:id="requestsBox"/>
            </VBox>
            <VBox styleClass="panel" prefWidth="330" spacing="4">
                <Label text="Суммы заявок" styleClass="page-title"/>
                <VBox fx:id="moneyBox"/>
            </VBox>
            <VBox styleClass="panel" prefWidth="330" spacing="4">
                <Label text="Справочники и отзывы" styleClass="page-title"/>
                <VBox fx:id="catalogBox"/>
            </VBox>
        </FlowPane>

        <HBox spacing="12">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Заявки по статусам" styleClass="page-title"/>
                <TableView fx:id="statusTable" prefHeight="250">
                    <columns>
                        <TableColumn fx:id="statusNameColumn" text="Статус" prefWidth="160"/>
                        <TableColumn fx:id="statusCountColumn" styleClass="numeric-column"
                                     text="Количество" prefWidth="100"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Объекты по категориям" styleClass="page-title"/>
                <TableView fx:id="categoryTable" prefHeight="250">
                    <columns>
                        <TableColumn fx:id="categoryNameColumn" text="Категория" prefWidth="160"/>
                        <TableColumn fx:id="categoryCountColumn" styleClass="numeric-column"
                                     text="Количество" prefWidth="100"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </HBox>

        <VBox spacing="6">
            <Label text="Заявки за период" styleClass="page-title"/>
            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="filter-bar">
                <Label text="С" styleClass="form-label"/>
                <DatePicker fx:id="fromPicker" prefWidth="140"/>
                <Label text="по" styleClass="form-label"/>
                <DatePicker fx:id="toPicker" prefWidth="140"/>
                <Button text="Посчитать" onAction="#onCountPeriod" styleClass="primary-button"/>
                <Label fx:id="periodResult" styleClass="page-title"/>
            </HBox>
        </VBox>
    </VBox>
</ScrollPane>
