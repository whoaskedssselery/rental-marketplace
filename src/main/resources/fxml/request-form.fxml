<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="rentalmarketplace.fx.controller.RequestFormController"
      spacing="12" prefWidth="460">
    <padding>
        <Insets top="4" right="4" bottom="4" left="4"/>
    </padding>
    <Label fx:id="hintLabel" wrapText="true" styleClass="muted-text"/>
    <GridPane hgap="12" vgap="10">
        <columnConstraints>
            <ColumnConstraints minWidth="110"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>
        <Label text="Объект" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ComboBox fx:id="listingBox" maxWidth="Infinity" promptText="Выберите объект"
                  GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Арендатор" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <ComboBox fx:id="renterBox" maxWidth="Infinity" promptText="Выберите арендатора"
                  GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="Дата начала" styleClass="form-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <DatePicker fx:id="startPicker" maxWidth="Infinity"
                    GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Label text="Дата окончания" styleClass="form-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <DatePicker fx:id="endPicker" maxWidth="Infinity"
                    GridPane.rowIndex="3" GridPane.columnIndex="1"/>
    </GridPane>
    <Label fx:id="totalLabel" styleClass="page-title"/>
</VBox>
