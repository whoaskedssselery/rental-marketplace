<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="rentalmarketplace.fx.controller.RequestsController"
      spacing="10">
    <padding>
        <Insets top="12" right="12" bottom="12" left="12"/>
    </padding>
    <fx:include fx:id="requestFilter" source="request-filter.fxml"/>
    <HBox alignment="CENTER_LEFT" spacing="8">
        <Button text="Добавить" onAction="#onAdd" styleClass="primary-button"/>
        <Button fx:id="editButton" text="Изменить даты" onAction="#onEdit"
                styleClass="secondary-button"/>
        <Button fx:id="statusButton" text="Сменить статус" onAction="#onChangeStatus"
                styleClass="secondary-button"/>
        <Button fx:id="detailsButton" text="Подробнее" onAction="#onDetails"
                styleClass="secondary-button"/>
        <Button fx:id="deleteButton" text="Удалить" onAction="#onDelete"
                styleClass="danger-button"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="countLabel" styleClass="muted-text"/>
    </HBox>
    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idColumn" text="Номер" prefWidth="70"/>
            <TableColumn fx:id="listingColumn" text="Объект" prefWidth="190"/>
            <TableColumn fx:id="renterColumn" text="Арендатор" prefWidth="150"/>
            <TableColumn fx:id="ownerColumn" text="Владелец" prefWidth="150"/>
            <TableColumn fx:id="startColumn" text="Начало" prefWidth="95"/>
            <TableColumn fx:id="endColumn" text="Конец" prefWidth="95"/>
            <TableColumn fx:id="statusColumn" text="Статус" prefWidth="115"/>
            <TableColumn fx:id="totalColumn" text="Сумма" prefWidth="120"/>
            <TableColumn fx:id="createdColumn" text="Создана" prefWidth="130"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>
</VBox>
