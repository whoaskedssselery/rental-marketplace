<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="rentalmarketplace.fx.controller.ReviewsController"
      spacing="10">
    <padding>
        <Insets top="12" right="12" bottom="12" left="12"/>
    </padding>
    <FlowPane hgap="12" vgap="8" styleClass="filter-bar" alignment="BOTTOM_LEFT">
        <VBox spacing="4">
            <Label text="Поиск" styleClass="form-label"/>
            <TextField fx:id="searchField" prefWidth="240"
                       promptText="Объект, арендатор, комментарий" onAction="#onApply"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Оценка" styleClass="form-label"/>
            <ComboBox fx:id="ratingFilterBox" prefWidth="140"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Сортировка" styleClass="form-label"/>
            <ComboBox fx:id="sortBox" prefWidth="160"/>
        </VBox>
        <CheckBox fx:id="descendingBox" text="По убыванию"/>
        <Button text="Применить" onAction="#onApply" styleClass="primary-button"/>
        <Button text="Сбросить" onAction="#onReset" styleClass="secondary-button"/>
    </FlowPane>
    <HBox alignment="CENTER_LEFT" spacing="8">
        <Button text="Добавить" onAction="#onAdd" styleClass="primary-button"/>
        <Button fx:id="editButton" text="Изменить" onAction="#onEdit"
                styleClass="secondary-button"/>
        <Button fx:id="deleteButton" text="Удалить" onAction="#onDelete"
                styleClass="danger-button"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="countLabel" styleClass="muted-text"/>
    </HBox>
    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idColumn" text="Номер" prefWidth="70"/>
            <TableColumn fx:id="listingColumn" text="Объект" prefWidth="210"/>
            <TableColumn fx:id="renterColumn" text="Арендатор" prefWidth="160"/>
            <TableColumn fx:id="ratingColumn" styleClass="numeric-column" text="Оценка" prefWidth="80"/>
            <TableColumn fx:id="commentColumn" text="Комментарий" prefWidth="320"/>
            <TableColumn fx:id="createdColumn" text="Создан" prefWidth="130"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>
    <Label fx:id="summaryLabel" styleClass="muted-text" wrapText="true"/>
</VBox>
