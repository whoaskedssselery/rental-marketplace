<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="rentalmarketplace.fx.controller.MainController"
            styleClass="main-pane">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="8" styleClass="toolbar">
            <padding>
                <Insets top="8" right="12" bottom="8" left="12"/>
            </padding>
            <Label text="Маркетплейс аренды" styleClass="app-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="refreshButton" text="Обновить" onAction="#onRefresh"
                    styleClass="primary-button"/>
            <Button fx:id="exportAllButton" text="Экспорт всех вкладок" onAction="#onExportAll"
                    styleClass="secondary-button"/>
            <Button fx:id="exportButton" text="Экспорт" onAction="#onExport"
                    styleClass="secondary-button"/>
        </HBox>
    </top>
    <center>
        <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE">
            <Tab text="Заявки">
                <fx:include fx:id="requests" source="requests.fxml"/>
            </Tab>
            <Tab text="Объекты">
                <fx:include fx:id="listings" source="listings.fxml"/>
            </Tab>
            <Tab text="Пользователи">
                <fx:include fx:id="users" source="users.fxml"/>
            </Tab>
            <Tab text="Отзывы">
                <fx:include fx:id="reviews" source="reviews.fxml"/>
            </Tab>
            <Tab text="Статистика">
                <fx:include fx:id="statistics" source="statistics.fxml"/>
            </Tab>
        </TabPane>
    </center>
    <bottom>
        <HBox alignment="CENTER_LEFT" styleClass="status-bar">
            <padding>
                <Insets top="4" right="12" bottom="4" left="12"/>
            </padding>
            <Label fx:id="statusLabel"/>
        </HBox>
    </bottom>
</BorderPane>
