<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>

<FlowPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="rentalmarketplace.fx.controller.RequestFilterController"
          hgap="12" vgap="8" styleClass="filter-bar">
    <VBox spacing="4">
        <Label text="Поиск" styleClass="form-label"/>
        <TextField fx:id="searchField" prefWidth="220"
                   promptText="Объект, арендатор, владелец" onAction="#onApply"/>
    </VBox>
    <VBox spacing="4">
        <Label text="Статус" styleClass="form-label"/>
        <ComboBox fx:id="statusBox" prefWidth="150"/>
    </VBox>
    <VBox spacing="4">
        <Label text="Владелец" styleClass="form-label"/>
        <ComboBox fx:id="ownerBox" prefWidth="170"/>
    </VBox>
    <VBox spacing="4">
        <Label text="Период с" styleClass="form-label"/>
        <DatePicker fx:id="fromPicker" prefWidth="130"/>
    </VBox>
    <VBox spacing="4">
        <Label text="по" styleClass="form-label"/>
        <DatePicker fx:id="toPicker" prefWidth="130"/>
    </VBox>
    <VBox spacing="4">
        <Label text="Сортировка" styleClass="form-label"/>
        <ComboBox fx:id="sortBox" prefWidth="160"/>
    </VBox>
    <VBox spacing="4">
        <Label text=" "/>
        <CheckBox fx:id="descendingBox" text="По убыванию"/>
    </VBox>
    <VBox spacing="4">
        <Label text=" "/>
        <Button text="Применить" onAction="#onApply" styleClass="primary-button"/>
    </VBox>
    <VBox spacing="4">
        <Label text=" "/>
        <Button text="Сбросить" onAction="#onReset" styleClass="secondary-button"/>
    </VBox>
</FlowPane>
